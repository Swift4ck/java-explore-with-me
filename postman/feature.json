        {
          "name": "Get comment by event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is an array\", function () {\r",
                  "    pm.expect(pm.response.json()).to.be.an('array');\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Array is not empty\", function () {\r",
                  "    pm.expect(pm.response.json().length).to.be.greaterThan(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Each comment has required fields\", function () {\r",
                  "    const comments = pm.response.json();\r",
                  "    comments.forEach(comment => {\r",
                  "        pm.expect(comment).to.have.property('id');\r",
                  "        pm.expect(comment).to.have.property('text');\r",
                  "        pm.expect(comment).to.have.property('authorId');\r",
                  "        pm.expect(comment).to.have.property('eventId');\r",
                  "        pm.expect(comment).to.have.property('created');\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"All comments belong to requested event\", function () {\r",
                  "    const comments = pm.response.json();\r",
                  "    const expectedEventId = 1; \r",
                  "    comments.forEach(comment => {\r",
                  "        pm.expect(comment.eventId).to.eql(expectedEventId);\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Comments are sorted by created ascending\", function () {\r",
                  "    const comments = pm.response.json();\r",
                  "    for (let i = 0; i < comments.length - 1; i++) {\r",
                  "        const current = new Date(comments[i].created);\r",
                  "        const next = new Date(comments[i + 1].created);\r",
                  "        pm.expect(current <= next).to.be.true;\r",
                  "    }\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Created field is a valid date\", function () {\r",
                  "    const comments = pm.response.json();\r",
                  "    comments.forEach(comment => {\r",
                  "        const date = new Date(comment.created);\r",
                  "        pm.expect(date.toString()).to.not.eql('Invalid Date');\r",
                  "    });\r",
                  "});"
                ],
