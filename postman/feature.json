              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\npm.test(\"Status code is 200 or 201\", function () {\n    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\n});\n\n\npm.test(\"Response has body and is JSON\", function () {\n    pm.expect(pm.response.responseSize).to.be.above(0); // Тело не пустое\n    pm.expect(pm.response.headers.get('content-type')).to.contain('application/json'); \n});\n\n\npm.test(\"Идентификатор автора совпадает с запрошенным идентификатором пользователя\", function () {\n    var jsonData = pm.response.json();\n\n    var requestedUserId = pm.request.url.query.get(\"userId\");\n\n    pm.expect(jsonData.authorId).to.eql(Number(requestedUserId));\n});\n\n\npm.test(\"Идентификатор события соответствует запрошенному EventID\", function () {\n    var jsonData = pm.response.json();\n    \n\n    var pathParts = pm.request.url.path;\n    \n\n    var requestedEventId = pathParts[1]; \n    \n\n    pm.expect(jsonData.eventId).to.eql(Number(requestedEventId));\n});\n\n\npm.test(\"Текст комментария совпадает с отправленным текстом\", function () {\n    var jsonData = pm.response.json();\n    \n\n    var sentTextRaw = pm.request.body.raw;\n    \n\n    var requestJson = JSON.parse(sentTextRaw);\n    \n\n    pm.expect(jsonData.text).to.eql(requestJson.text);\n});\n\n\npm.test(\"Присутствует дата создания\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.created).to.not.be.undefined;\n    pm.expect(jsonData.created).to.be.a('string');\n});\n\npm.test(\"Идентификатор комментария - это положительное число\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.id).to.be.a('number');\n    pm.expect(jsonData.id).to.be.above(0);\n});"
                ]
              }
